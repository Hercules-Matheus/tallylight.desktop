{
  "name": "tally-desktop",
  "version": "2.1.0",
  "description": "Motor do Tally Cloud",
  "author": {
    "name": "Hercules Matheus",
    "email": "hmls235@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "clean": "rimraf dist",
    "build-app": "electron-builder",
    "release": "npm run clean && electron-builder --win --linux --mac",
    "release:win": "npm run clean && electron-builder --win",
    "release:linux": "npm run clean && electron-builder --linux",
    "release:mac": "npm run clean && electron-builder --mac"
  },
  "build": {
    "appId": "com.tallycloud.desktop",
    "productName": "Tally Light Cloud",
    "asar": true,
    "extraResources": [
      ".env"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "TallyLightCloud-Windows-Installer.${ext}"
    },
    "portable": {
      "artifactName": "TallyLightCloud-Windows-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons",
      "category": "Video",
      "artifactName": "TallyLightCloud-Linux.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.video",
      "artifactName": "TallyLightCloud-Mac.${ext}"
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/electron",
      "!node_modules/electron-builder"
    ]
  },
  "dependencies": {
    "atem-connection": "^3.9.0"
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "rimraf": "^5.0.0"
  }
}