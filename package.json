{
  "name": "tally-desktop",
  "version": "2.0.0",
  "description": "Motor de Tally Cloud (Supabase)",
  "author": "Hercules",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "clean": "rimraf dist",
    "build-app": "electron-builder",
    "release": "npm run clean && npm run build-app"
  },
  "build": {
    "appId": "com.vvp.tally",
    "productName": "Tally Light Cloud",
    "asar": true,
    "extraResources": [
      ".env"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/icon.ico",
      "node_modules/**/*",
      "!node_modules/electron",
      "!node_modules/electron-builder"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "atem-connection": "^3.9.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "rimraf": "^5.0.0"
  }
}
